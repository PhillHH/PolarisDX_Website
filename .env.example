# =============================================================================
# PolarisDX — Build-/Laufzeitkonfiguration des Frontends
# =============================================================================
# Diese Datei ist eine VORLAGE. Sie enthaelt keine Werte, nur Namen und die
# Regeln, nach denen sie gesetzt werden. Kopieren nach `.env`, `.env.preview`
# oder in die CI-/Container-Umgebung.
#
# Alles mit `VITE_`-Praefix wird zur BAUZEIT in das Bundle eingebacken. Es ist
# damit oeffentlich sichtbar — hier gehoert kein Geheimnis hinein.
# =============================================================================

# -----------------------------------------------------------------------------
# Umgebung
# -----------------------------------------------------------------------------
# production | preview | staging
#
# Steuert die Analytics-Isolation (siehe unten). Eine Umgebung, die sich nicht
# benennt, gilt als undeklariert und wird wie Produktion behandelt — deshalb
# muss jede Vorschau sie ausdruecklich setzen.
VITE_APP_ENV=production

# -----------------------------------------------------------------------------
# Google Tag Manager / GA4 (AP23)
# -----------------------------------------------------------------------------
# AP23 PT23.4 — drei Regeln, jede aus einem konkreten Grund:
#
#  1. OHNE Kennung laedt KEIN Container. Auch nach erteilter Einwilligung
#     nicht. Eine ungeprueft eingebaute Kennung waere ein Datenabfluss an
#     einen Container, von dem niemand belegt hat, wem er gehoert.
#
#  2. Der historische Container der Altseite ist ein BASELINE-HINWEIS, kein
#     Standardwert. Er steht als Beleg in `src/lib/analyticsConfig.ts` und
#     wird nirgends als Vorgabe verwendet.
#
#  3. Eine Vorschau bekommt einen EIGENEN Container. Der Produktionscontainer
#     wird in `VITE_APP_ENV=preview|staging` ausdruecklich unterdrueckt, auch
#     wenn er gesetzt ist: Testklicks in derselben GA4-Property waeren in der
#     Auswertung nicht mehr von echten Besucherinnen zu unterscheiden.
#
# Format wird geprueft; ein syntaktisch falscher Wert wird VERWORFEN, nicht
# durchgereicht (ein Tippfehler wuerde sonst einen fremden Container treffen).
VITE_GTM_CONTAINER_ID=

# Nur fuer VITE_APP_ENV=preview|staging. In diesen Umgebungen ist das die
# EINZIGE Kennung, die geladen wird.
VITE_GTM_CONTAINER_ID_PREVIEW=

# Optional. Nur noetig, wenn im Container mehr als ein GA4-Ziel haengt —
# dann macht `send_to` das Routing eindeutig.
VITE_GA4_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Technische Telemetrie (AP23 PT23.5)
# -----------------------------------------------------------------------------
# STRIKT getrennt von Marketing-Analytics oben. Web Vitals und Renderfehler
# sind Selbstbeobachtung der eigenen Seite, keine Personenanalyse — und sie
# duerfen den Marketing-Consent nicht heimlich umgehen.
#
# Auslieferungszustand ist NONE: die Erhebung laeuft im Browser, aber nichts
# verlaesst ihn. Das ist der datensparsamste Zustand und braucht keine
# Einwilligung, weil es keine Uebertragung an Dritte gibt.
#
#   NONE         nichts verlaesst den Browser (Standard)
#   FIRST_PARTY  eigener Endpunkt derselben Herkunft, kein Drittanbieter
#   THIRD_PARTY  externer Dienst — braucht ALLE vier Belege unten
VITE_TELEMETRY_SCOPE=NONE

# Nur fuer THIRD_PARTY. Ohne vollstaendige Belege verweigert
# `mayRegisterTelemetryTransport` die Aktivierung mit
# `BLOCKED_POLICY_DECISION` und benennt genau den fehlenden Punkt.
# Hier wird keine Rechtsgrundlage erfunden: diese Schalter bestaetigen nur,
# dass die Entscheidung anderswo wirklich getroffen wurde.
VITE_TELEMETRY_PURPOSE_DOCUMENTED=
VITE_TELEMETRY_PROCESSOR_AGREED=
VITE_TELEMETRY_RETENTION_DEFINED=
VITE_TELEMETRY_PRIVACY_NOTICE_UPDATED=
