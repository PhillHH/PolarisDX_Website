

# Frontend URL for CORS (optional, defaults to http://localhost:3000)
FRONTEND_URL=http://localhost:5173

# Server Port (optional, defaults to 5000)
PORT=5000

# Durable shared lead store. Production Compose mounts this directory as a named volume.
LEAD_DB_PATH=/var/lib/polarisdx/leads.sqlite3

# Umgebung (AP22 PT22.8 / AP28): `preview` bzw. `staging` erzwingt den Trockenlauf — kein
# Provider-Aufruf, auch nicht mit DRY_RUN=0. Produktion: `production`.
APP_ENV=development

# Mail-Zustellung (Secret — nie ins Repo, nie ins Image; Rotation: SECURITY-CONTRACT OA-11).
SENDGRID_API_KEY=
CONTACT_RECEIVER=
SENDER_EMAIL=

# Trockenlauf auch ausserhalb von preview/staging (lokal empfohlen: 1).
DRY_RUN=1

# Bind-Host; im Container 0.0.0.0, lokal Loopback.
LISTEN_HOST=127.0.0.1

# Support-Anhaenge (gleiches Volume wie die Datenbank).
SUPPORT_UPLOAD_DIR=/var/lib/polarisdx/support-uploads

# Betrieb (Standardwerte in server/server.js): Dispatcher, Aufbewahrung, Alarme.
# LEAD_DISPATCHER_DISABLED=1
# LEAD_DISPATCHER_INTERVAL_MS=30000
# LEAD_RETENTION_APPLY=1
# LEAD_RETENTION_INTERVAL_MS=21600000
# LEAD_ALERT_INTERVAL_MS=300000
