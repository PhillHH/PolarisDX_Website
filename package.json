{
  "name": "polarisdx-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx server.ts",
    "dev:vite": "vite",
    "build": "npm run check:befunde && npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:prerender": "tsc -b && vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "start": "TSX_TSCONFIG_PATH=tsconfig.app.json NODE_ENV=production tsx server.ts",
    "preview": "TSX_TSCONFIG_PATH=tsconfig.app.json NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check:colors": "node scripts/check-color-tokens.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "a11y:gate": "playwright test --config e2e/pt24.6.config.ts",
    "a11y:suite": "playwright test --config e2e/pt24.1.config.ts && playwright test --config e2e/pt24.2.config.ts && playwright test --config e2e/pt24.3.config.ts && playwright test --config e2e/pt24.4.config.ts && playwright test --config e2e/pt24.5.config.ts && playwright test --config e2e/pt24.6.config.ts",
    "perf:build": "vite build --manifest --outDir node_modules/.cache/pt25.1/client --emptyOutDir && vite build --ssr src/entry-server.tsx --outDir node_modules/.cache/pt25.1/server --emptyOutDir",
    "perf:bundle": "node scripts/perf/bundle-report.mjs node_modules/.cache/pt25.1/client --json node_modules/.cache/pt25.1/results/bundle-report.json",
    "perf:http": "node scripts/perf/http-matrix.mjs",
    "perf:lighthouse": "node scripts/perf/lighthouse-matrix.mjs",
    "perf:collect": "playwright test --config e2e/pt25.1.config.ts",
    "perf:budget:build": "vite build --manifest --outDir node_modules/.cache/perf-budget/client --emptyOutDir && vite build --ssr src/entry-server.tsx --outDir node_modules/.cache/perf-budget/server --emptyOutDir",
    "check:perf-budget": "node scripts/perf/check-budgets.mjs --build node_modules/.cache/perf-budget --profile ci",
    "check:perf-budget:lab": "node scripts/perf/check-budgets.mjs --build node_modules/.cache/perf-budget --profile lab",
    "screenshots:baseline": "node scripts/baseline-screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --reporter=default",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:server": "vitest run --project server",
    "test:integration": "vitest run --project server server/lead-pipeline.integration.test.js server/gated-entitlement.integration.test.js server/preview-isolation.endpoint.test.js",
    "test:integration:http": "playwright test --config e2e/pt27.2.config.ts",
    "test:e2e:core": "playwright test --config e2e/pt27.3.config.ts",
    "test:e2e:consent": "playwright test --config e2e/pt27.4.config.ts",
    "test:visual": "playwright test --config e2e/pt27.6-visual.config.ts",
    "test:visual:docker": "docker run --rm --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=true -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.57.0-noble npm run test:visual",
    "check:claims": "node scripts/check-igloo-claim-contract.mjs && node scripts/check-epigenetics-claim-contract.mjs",
    "check:visual-changelog": "node scripts/check-visual-baseline-changelog.mjs --self-test && node scripts/check-visual-baseline-changelog.mjs --worktree",
    "test:seo:regression": "npm run check:routes && npm run check:search-index && npm run check:seo && npm run check:befunde-seo && playwright test --config e2e/pt27.5.config.ts",
    "test:guards": "npm run check:colors && npm run check:ds-changelog && npm run check:shell-i18n && npm run check:i18n -- --self-test && npm run check:nav-targets && npm run check:search-index && npm run check:internal-findability && npm run check:routes && npm run check:seo",
    "test:e2e": "playwright test",
    "server": "cd server && npm install && npm start",
    "prepare": "lefthook install",
    "visual:gallery": "tsx scripts/build-visual-gallery.tsx",
    "check:ds-changelog": "node scripts/check-design-system-changelog.mjs",
    "check:shell-i18n": "node scripts/check-shell-i18n.mjs",
    "check:routes": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-route-registry.ts",
    "check:http-status": "playwright test e2e/url-smoke.spec.ts",
    "check:nav-targets": "npm run check:routes -- --nav-only",
    "check:search-index": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-search-index.ts",
    "check:internal-findability": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-internal-findability.ts",
    "check:i18n": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-i18n.ts",
    "check:i18n:contract": "npm run check:i18n -- --write-contract",
    "check:assets": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-resource-assets.ts",
    "check:epigenetics-resources": "node scripts/check-epigenetics-resources.mjs",
    "check:resource-inventory": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-resource-inventory.ts",
    "check:resource-center": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-resource-center.ts",
    "build:resource-registry": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/build-resource-registry.ts --write",
    "check:content-download": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-content-download.ts",
    "check:lead-magnets": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-lead-magnet-candidates.ts",
    "test:content-download": "vitest run server/content-download.test.js server/content-download.endpoint.test.js",
    "check:befunde": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-befunde.ts",
    "check:befunde-seo": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-befunde-seo.ts",
    "check:lead-foundation": "vitest run server/lead-foundation/lead-foundation.test.js",
    "check:seo": "node scripts/check-meta-descriptions.mjs && TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/check-seo.ts",
    "check:consumer-images": "node scripts/check-consumer-images.mjs",
    "build:consumer-images": "node scripts/build-consumer-images.mjs",
    "check:article-images": "node scripts/check-article-images.mjs",
    "build:article-images": "node scripts/build-article-images.mjs",
    "lead:ops": "node scripts/lead-ops.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high && npm audit --prefix server --audit-level=high",
    "security:secrets": "docker run --rm -v \"$PWD\":/repo -w /repo zricethezav/gitleaks:v8.30.1 git /repo --redact=100 --no-banner --exit-code 1",
    "security:test": "vitest run src/security/contentSecurityPolicy.test.ts src/api/journeyEnvelope.test.ts src/lib/analyticsIsolation.test.ts src/lib/trackingTaxonomy.test.ts server/chat-removal.test.js server/security-headers.endpoint.test.js server/api-security.endpoint.test.js server/integration-security.test.js server/preview-isolation.endpoint.test.js server/secret-hygiene.test.js server/download-log-redaction.nginx.test.js server/lead-queue.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.3",
    "i18next": "^25.6.3",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.3.5",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.11.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "lefthook": "^2.1.6",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "saxes": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  }
}
